{
  "openapi": "3.1.0",
  "info": {
    "title": "DesignCraft Render API",
    "description": "IDML 업로드 → 비동기 렌더 작업 → PNG/PDF 다운로드 API. IDML_API_TOKEN이 설정된 서버에서는 /renders 계열의 모든 요청에 Authorization: Bearer <token>이 필요합니다. 202는 작업 접수 성공이며 렌더링 성공 여부는 작업 status로 확인합니다.",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "worker 상태 확인",
        "operationId": "health_healthz_get",
        "responses": {
          "200": {
            "description": "worker 정상; 렌더링을 직접 실행하는 검사는 아님",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "worker 중지 또는 종료 처리 중",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "unhealthy"
                      ]
                    }
                  },
                  "type": "object",
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/renders": {
      "post": {
        "tags": [
          "renders"
        ],
        "summary": "IDML 업로드 및 렌더 작업 접수",
        "description": "multipart/form-data로 .idml 또는 패키지 .zip을 업로드합니다. ZIP 루트에는 IDML 1개, 선택적으로 Links/ 및 Document Fonts/를 넣습니다. 기본 업로드 한도는 128 MiB입니다. 응답의 status_url을 조회해 완료를 확인합니다.",
        "operationId": "render_renders_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_render_renders_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderJob"
                }
              }
            }
          },
          "400": {
            "description": "빈 파일, 잘못된 ZIP 패키지 또는 잘못된 요청 헤더",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "설정된 Bearer 토큰이 없거나 일치하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "408": {
            "description": "업로드 제한 시간 초과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "업로드 파일 또는 요청 본문 크기 초과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "415": {
            "description": "지원하지 않는 업로드 확장자",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "동시 업로드 또는 저장 작업 수 한도 초과",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "renders"
        ],
        "summary": "작업 목록 조회",
        "description": "최신 생성 순서의 배열입니다. 페이지네이션의 전체 개수는 반환하지 않습니다.",
        "operationId": "list_jobs_renders_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1024,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RenderJob"
                  },
                  "title": "Response List Jobs Renders Get"
                }
              }
            }
          },
          "401": {
            "description": "설정된 Bearer 토큰이 없거나 일치하지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
