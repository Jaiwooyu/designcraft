  "components": {
    "schemas": {
      "Artifact": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "media_type": {
            "type": "string",
            "title": "Media Type"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          }
        },
        "type": "object",
        "required": [
          "name",
          "media_type",
          "size",
          "download_url"
        ],
        "title": "Artifact"
      },
      "Body_render_renders_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "An IDML or a ZIP with IDML + Links + Document Fonts"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "pdf",
              "both"
            ],
            "title": "Format",
            "default": "both"
          },
          "scale": {
            "type": "number",
            "maximum": 4.0,
            "minimum": 0.1,
            "title": "Scale",
            "default": 1
          },
          "fallback_font": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Font"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_render_renders_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RenderJob": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "uploading",
              "queued",
              "running",
              "cancelling",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "title": "Status"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "options": {
            "$ref": "#/components/schemas/RenderOptions"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "logs": {
            "type": "string",
            "title": "Logs"
          },
          "logs_truncated": {
            "type": "boolean",
            "title": "Logs Truncated"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "files": {
            "items": {
              "$ref": "#/components/schemas/Artifact"
            },
            "type": "array",
            "title": "Files"
          },
          "status_url": {
            "type": "string",
            "title": "Status Url"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "created_at",
          "updated_at",
          "options",
          "warnings",
          "logs",
          "logs_truncated",
          "error",
          "files",
          "status_url"
        ],
        "title": "RenderJob"
      },
      "RenderOptions": {
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "png",
              "pdf",
              "both"
            ],
            "title": "Format",
            "default": "both"
          },
          "scale": {
            "type": "number",
            "maximum": 4.0,
            "minimum": 0.1,
            "title": "Scale",
            "default": 1
          },
          "fallback_font": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
